# Server-only business backend origin. Use the cloud API URL in production.
BACKEND_API_URL=http://localhost:4100

# Legacy direct-browser backend origin; leave empty when using the proxy above.
NEXT_PUBLIC_API_URL=

# Optional exact cloud endpoint for future managed website-content integration.
# Until it is configured, Sites D1 is the working source of truth.
CONTENT_API_URL=

# Trusted production site origin used for social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
