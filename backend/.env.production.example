# ─────────────────────────────────────────────────────────────────────────────
# Cutz & Bangs — PRODUCTION environment template
# Copy to `.env` on the VPS and fill every value. Never commit the real .env.
# Items marked (YOU) require credentials only you can obtain — see CREDENTIALS.md.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
WA_DEFAULT_BRANCH_ID=main
DOMAIN=salon.example.com               # your real domain (DNS A record -> VPS IP)
PORT=4000

# ---- Database (persistent Docker volume; deploys never touch this) ----
POSTGRES_USER=cutz
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_SECRET      # (YOU) generate a strong password
POSTGRES_DB=cutz
DATABASE_URL=postgresql://cutz:REPLACE_WITH_STRONG_SECRET@db:5432/cutz?schema=public

# ---- First admin account seed ----
# Used once by: docker compose exec api pnpm --filter @cutz/db exec tsx prisma/seed.ts
# Remove SEED_OWNER_PASSWORD after the first successful login.
SEED_OWNER_EMAIL=admin@cutzandbangs.in
SEED_OWNER_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- API / security ----
CORS_ORIGIN=https://salon.example.com             # exact site origin(s), comma-separated. Do NOT use * in prod.
RATE_LIMIT_MAX=100
SESSION_TTL_HOURS=168
TOTP_ISSUER="Cutz & Bangs"
PUBLIC_APP_URL=https://salon.example.com
MAINTENANCE_TOKEN=REPLACE_WITH_RANDOM_64_HEX       # for the daily expiry cron (see DEPLOYMENT.md)
SECRETS_KEY=REPLACE_WITH_BASE64_32_BYTES           # encrypts provider tokens at rest

# ---- Site <-> backend link (consumed by the Codex salon UI) ----
# In the salon repo's .env: BACKEND_API_URL=https://salon.example.com  (server-side proxy)
#                           NEXT_PUBLIC_API_URL=https://salon.example.com
SITE_CONTENT_FILE=/app/.storage/site-content.json

# ---- Object storage for invoices / selfies / vendor bills ----
# Leave STORAGE_ACCESS_KEY and CLOUDINARY_* empty to use local-disk storage (STORAGE_DIR).
# Set CLOUDINARY_* for Cloudinary raw-file invoice/media archive, or STORAGE_* for S3/R2.
STORAGE_DIR=/data/storage
STORAGE_ENDPOINT=                                  # e.g. https://<account>.r2.cloudflarestorage.com  (blank for AWS S3)
STORAGE_REGION=auto
STORAGE_BUCKET=cutz-media
STORAGE_ACCESS_KEY=                                # (YOU)
STORAGE_SECRET_KEY=                                # (YOU)
CLOUDINARY_CLOUD_NAME=                             # (YOU)
CLOUDINARY_API_KEY=                                # (YOU)
CLOUDINARY_API_SECRET=                             # (YOU)
CLOUDINARY_FOLDER=cutz-bangs

# ---- Email (transactional: confirmations, reminders, invoices, campaigns) ----
SMTP_HOST=                                         # (YOU) e.g. smtp.postmarkapp.com / smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=                                         # (YOU)
SMTP_PASS=                                         # (YOU)
EMAIL_FROM="Cutz & Bangs <noreply@salon.example.com>"

# ---- SMS (optional; reminders/OTP) ----
SMS_PROVIDER=                                      # (YOU) e.g. twilio
SMS_ACCOUNT_SID=                                   # (YOU)
SMS_AUTH_TOKEN=                                    # (YOU)
SMS_FROM=

# ---- Official WhatsApp Business Platform (Meta Cloud API) ----
WA_OFFICIAL_TOKEN=                                 # (YOU) permanent system-user token
WA_OFFICIAL_PHONE_ID=                              # (YOU) phone number id
WA_APP_SECRET=                                     # (YOU) app secret (webhook signature)
WA_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_RANDOM_STRING # you choose; enter same value in Meta webhook config

# ---- Unofficial WhatsApp connector (optional, isolated worker) ----
WA_UNOFFICIAL_ENABLED=false                        # true only if you accept the account-ban risk
# QR pairing is done once at runtime by scanning from the WhatsApp app (see CREDENTIALS.md).
WA_UNOFFICIAL_URL=http://waha:3000                 # private compose service only
WAHA_ALLOWED_ORIGINS=http://waha:3000              # exact comma-separated origins trusted with X-Api-Key
WAHA_API_KEY=REPLACE_WITH_LONG_RANDOM_API_KEY
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=REPLACE_WITH_STRONG_DASHBOARD_PASSWORD
WAHA_SESSION=cutz-bangs-main
WA_UNOFFICIAL_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_WEBHOOK_SECRET

# ---- AI (campaign drafts, inbox FAQ, vendor-bill OCR) ----
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=                                 # (YOU)

# ---- Payments ----
# Payment GATEWAY is intentionally OUT OF SCOPE per instructions.
# POS uses UPI QR + manual payment marking only.
UPI_VPA=salon@upi                                  # (YOU) your salon UPI id
UPI_PAYEE=Cutz & Bangs

# ---- Backups (off-server copy) ----
BACKUP_DIR=/opt/cutz-backups
BACKUP_BUCKET=                                     # (YOU) optional S3 bucket for off-site dumps
