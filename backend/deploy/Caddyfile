# Automatic HTTPS. Replace the domain with your own.
{$DOMAIN:localhost} {
	encode gzip

	# Versioned backend API + webhooks live in Fastify.
	handle /api/v1/* {
		reverse_proxy api:4000
	}
	handle /health* {
		reverse_proxy api:4000
	}

	# Next.js owns /api/backend, /api/admin/content and other app routes.
	handle {
		reverse_proxy web:3000
	}
}

www.{$DOMAIN:localhost} {
	redir https://{$DOMAIN:localhost}{uri} permanent
}
