# ---- Core ----
NODE_ENV=production
DOMAIN=salon.example.com
PORT=4000

# ---- Database (persistent volume; app deploys never touch this) ----
POSTGRES_USER=cutz
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=cutz
DATABASE_URL=postgresql://cutz:change-me-strong@db:5432/cutz?schema=public

# ---- Redis (queues / cache / rate limit) ----
REDIS_URL=redis://redis:6379

# ---- API ----
CORS_ORIGIN=https://salon.example.com
RATE_LIMIT_MAX=100
TRUST_PROXY=true
SESSION_TTL_HOURS=168
TOTP_ISSUER="Cutz & Bangs"
PUBLIC_APP_URL=https://salon.example.com
ATTENDANCE_GEOFENCE_METERS=150

# ---- Web ----
NEXT_PUBLIC_API_URL=https://salon.example.com/api/v1
NEXT_PUBLIC_BRANCH_ID=main
WA_DEFAULT_BRANCH_ID=main

# ---- Storage (S3-compatible or Cloudinary) ----
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=cutz-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_DIR=/app/.storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cutz-bangs

# ---- Payment (UPI QR for MVP) ----
UPI_VPA=salon@upi
UPI_PAYEE=Cutz & Bangs

# ---- Email provider ----
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Cutz & Bangs <noreply@salon.example.com>"

# ---- WhatsApp (official Business Platform) ----
WA_OFFICIAL_TOKEN=
WA_OFFICIAL_PHONE_ID=
WA_OFFICIAL_WABA_ID=
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=
WA_GRAPH_VERSION=v23.0

# ---- WhatsApp (optional unofficial WAHA connector) ----
# Run with: docker compose --profile unofficial-wa up -d waha api worker
# Keep WAHA private; the compose service is not exposed on a host port.
WA_UNOFFICIAL_URL=http://waha:3000
WAHA_ALLOWED_ORIGINS=http://waha:3000
WA_UNOFFICIAL_CALLBACK_URL=http://api:4000/api/v1/webhooks/whatsapp/unofficial
WAHA_SESSION=cutz-bangs-main
WAHA_API_KEY=replace-with-a-different-long-random-value
WA_UNOFFICIAL_WEBHOOK_SECRET=replace-with-another-long-random-value
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-with-a-long-random-password

# ---- AI provider (drafts, FAQ assistant) ----
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
# Optional comma-separated allowlist for signed vendor-bill image hosts.
OCR_IMAGE_HOSTS=

# ---- Secrets encryption (required in production for provider tokens at rest) ----
# Generate once with: openssl rand -base64 32
SECRETS_KEY=replace-with-a-base64-encoded-32-byte-key
