# Copy to .env.isolated only inside the separate Cutz & Bangs v2 directory.
NODE_ENV=production
PORT=4000
CUTZ_API_PORT=8410

POSTGRES_USER=cutz_v2
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=cutz_v2
DATABASE_URL=postgresql://cutz_v2:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@db:5432/cutz_v2?schema=public
REDIS_URL=redis://redis:6379

# Exact public frontend origin. Add comma-separated origins only when required.
CORS_ORIGIN=https://cutz-bangs.sidharthkumar2028.chatgpt.site
TRUST_PROXY=true
RATE_LIMIT_MAX=100
SESSION_TTL_HOURS=168
TOTP_ISSUER="Cutz & Bangs"
PUBLIC_APP_URL=https://cutz-bangs.sidharthkumar2028.chatgpt.site
SECRETS_KEY=REPLACE_WITH_BASE64_32_BYTES
MAINTENANCE_TOKEN=REPLACE_WITH_RANDOM_64_HEX
ATTENDANCE_GEOFENCE_METERS=150

STORAGE_DIR=/app/.storage
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=cutz-media-v2
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# SMTP can also be entered from Admin > Settings after first login.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Cutz & Bangs <noreply@example.com>"

WA_OFFICIAL_TOKEN=
WA_OFFICIAL_PHONE_ID=
WA_OFFICIAL_WABA_ID=
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_RANDOM_STRING
WA_GRAPH_VERSION=v23.0

WA_UNOFFICIAL_URL=http://waha:3000
WA_UNOFFICIAL_CALLBACK_URL=https://api.example.com/api/v1/webhooks/whatsapp/unofficial
WAHA_SESSION=cutz-bangs-main
WAHA_API_KEY=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE
WA_UNOFFICIAL_WEBHOOK_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_VALUE
WAHA_DASHBOARD_USERNAME=cutz_admin
WAHA_DASHBOARD_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Optional, created as a separate Cloudflare tunnel for this stack.
CLOUDFLARE_TUNNEL_TOKEN=

ANTHROPIC_API_KEY=
OCR_IMAGE_HOSTS=
UPI_VPA=salon@upi
UPI_PAYEE=Cutz & Bangs
